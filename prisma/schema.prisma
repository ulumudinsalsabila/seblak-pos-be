generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
  KITCHEN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum OutletStatus {
  ACTIVE
  SUSPENDED
}

enum FeeType {
  NONE
  FIXED
  PERCENTAGE
  HYBRID
}

enum FeeLedgerType {
  CHARGE
  REVERSAL
  ADJUSTMENT
}

enum FeeLedgerStatus {
  PENDING
  INVOICED
  PAID
  VOID
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PricingType {
  FIXED
  PER_ITEM
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum TransactionStatus {
  PAID
  VOID
}

enum KitchenStatus {
  PENDING
  COMPLETED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum BrothLevel {
  LITTLE
  MEDIUM
  MUCH
}

enum TastePreference {
  SALTY
  SAVORY
  SWEET
}

enum ReceiptPaperSize {
  MM58
  MM80
}

enum InventoryItemType {
  INGREDIENT
  SEMI_FINISHED
  PACKAGED
}

enum UnitDimension {
  MASS
  VOLUME
  COUNT
}

enum UnitConversionMode {
  SAME_DIMENSION
  PACKAGING
  DENSITY
}

enum StockLocationType {
  WAREHOUSE
  OUTLET
  KITCHEN
  OTHER
}

enum StockMovementDirection {
  IN
  OUT
}

enum StockMovementType {
  OPENING_BALANCE
  PURCHASE_RECEIVED
  SALE_CONSUMED
  SALE_REVERSED
  PREP_ISSUED
  PREP_RECEIVED
  TRANSFER_SHIPPED
  TRANSFER_RECEIVED
  WASTE_POSTED
  ADJUSTMENT_POSTED
  STOCKTAKE_VARIANCE_POSTED
  /// Inputs of a voided prep batch returned to stock.
  PREP_REVERSED
}

enum InventoryPermission {
  VIEW_INVENTORY
  VIEW_INVENTORY_COST
  VIEW_INVENTORY_LEDGER
  MANAGE_INVENTORY_ITEMS
  MANAGE_INVENTORY_LOCATIONS
  POST_INVENTORY_OPENING
  MANAGE_INVENTORY_RECIPES
  RECEIVE_INVENTORY_PURCHASES
  POST_INVENTORY_WASTE
  POST_INVENTORY_ADJUSTMENTS
  COUNT_INVENTORY_STOCKTAKE
  APPROVE_INVENTORY_STOCKTAKE
  POST_INVENTORY_PREP
}

enum StockAdjustmentKind {
  WASTE
  ADJUSTMENT
}

enum StockAdjustmentReason {
  EXPIRED
  SPOILED
  SPILLED
  DAMAGED
  STAFF_MEAL
  COUNT_CORRECTION
  FOUND
  OTHER
  /// System-only: ingredients of an order voided after the kitchen completed it.
  VOIDED_ORDER
}

enum StocktakeStatus {
  COUNTING
  REVIEW
  POSTED
  CANCELLED
}

enum ProductInventoryMode {
  DIRECT
  RECIPE
}

model User {
  id                   String                     @id @default(uuid()) @db.Uuid
  name                 String                     @db.VarChar(100)
  email                String                     @unique @db.VarChar(254)
  passwordHash         String
  role                 Role
  status               UserStatus                 @default(ACTIVE)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(3)
  refreshTokens        RefreshToken[]
  transactions         Transaction[]              @relation("CashierTransactions")
  voidedTransactions   Transaction[]              @relation("VoidedTransactions")
  expenses             Expense[]
  outletMemberships    OutletMembership[]
  inventoryGrants      InventoryPermissionGrant[]
  inventoryMovements   StockMovement[]            @relation("InventoryMovementActor")
  inventoryAudits      InventoryAuditEvent[]      @relation("InventoryAuditActor")
  purchaseReceipts     PurchaseReceipt[]          @relation("PurchaseReceiptCreator")
  stockAdjustments     StockAdjustment[]          @relation("StockAdjustmentCreator")
  stocktakesCreated    Stocktake[]                @relation("StocktakeCreator")
  stocktakesSubmitted  Stocktake[]                @relation("StocktakeSubmitter")
  stocktakesApproved   Stocktake[]                @relation("StocktakeApprover")
  stocktakesCancelled  Stocktake[]                @relation("StocktakeCanceller")
  stocktakeCounts      StocktakeLine[]            @relation("StocktakeCounter")
  prepBatchesStarted   PrepBatch[]                @relation("PrepBatchStarter")
  prepBatchesCompleted PrepBatch[]                @relation("PrepBatchCompleter")
  prepBatchesVoided    PrepBatch[]                @relation("PrepBatchVoider")
}

model Tenant {
  id                      String                     @id @default(uuid()) @db.Uuid
  name                    String                     @db.VarChar(100)
  slug                    String                     @unique @db.VarChar(80)
  status                  TenantStatus               @default(ACTIVE)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                   @updatedAt @db.Timestamptz(3)
  outlets                 Outlet[]
  inventoryUnits          InventoryUnit[]
  inventoryItems          InventoryItem[]
  itemUnitConversions     ItemUnitConversion[]
  stockLocations          StockLocation[]
  stockBalances           StockBalance[]
  stockMovements          StockMovement[]
  inventoryGrants         InventoryPermissionGrant[]
  inventoryAuditEvents    InventoryAuditEvent[]
  productInventoryConfigs ProductInventoryConfig[]
  inventoryRecipeVersions InventoryRecipeVersion[]
  inventoryRecipeLines    InventoryRecipeLine[]
  purchaseReceipts        PurchaseReceipt[]
  purchaseReceiptLines    PurchaseReceiptLine[]
  stockAdjustments        StockAdjustment[]
  stockAdjustmentLines    StockAdjustmentLine[]
  stocktakes              Stocktake[]
  stocktakeLines          StocktakeLine[]
  menuOptionConsumptions  MenuOptionConsumption[]
  prepRecipes             PrepRecipe[]
  prepRecipeLines         PrepRecipeLine[]
  prepBatches             PrepBatch[]
  prepBatchInputs         PrepBatchInput[]
  theme                   TenantTheme?
}

model TenantTheme {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @db.Uuid
  primaryColor String   @default("#C2410C") @db.VarChar(7)
  logoUrl      String?  @db.VarChar(500)
  faviconUrl   String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Outlet {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @db.Uuid
  name               String                  @db.VarChar(100)
  code               String                  @db.VarChar(50)
  status             OutletStatus            @default(ACTIVE)
  timezone           String                  @default("Asia/Jakarta") @db.VarChar(50)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships        OutletMembership[]
  categories         Category[]
  products           Product[]
  transactions       Transaction[]
  transactionItems   TransactionItem[]
  expenses           Expense[]
  settings           StoreSettings?
  invoiceCounters    DailyInvoiceCounter[]
  feeConfigs         FeeConfig[]
  feeLedgers         FeeLedger[]
  stockLocations     StockLocation[]
  optionConsumptions MenuOptionConsumption[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model OutletMembership {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  outletId  String     @db.Uuid
  role      Role
  status    UserStatus @default(ACTIVE)
  isDefault Boolean    @default(false)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet    Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([outletId, role])
}

model FeeConfig {
  id            String    @id @default(uuid()) @db.Uuid
  outletId      String    @db.Uuid
  type          FeeType   @default(NONE)
  fixedAmount   Int       @default(0)
  percentage    Decimal   @default(0) @db.Decimal(7, 4)
  effectiveFrom DateTime  @default(now()) @db.Timestamptz(3)
  effectiveTo   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  outlet        Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, effectiveFrom, effectiveTo])
}

model FeeLedger {
  id            String          @id @default(uuid()) @db.Uuid
  outletId      String          @db.Uuid
  transactionId String?         @db.Uuid
  type          FeeLedgerType
  amount        Int
  status        FeeLedgerStatus @default(PENDING)
  description   String?         @db.VarChar(500)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  outlet        Outlet          @relation(fields: [outletId], references: [id], onDelete: Restrict)
  transaction   Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([outletId, status, createdAt])
  @@index([transactionId])
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  tokenHash String
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  outletId    String    @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  products    Product[]
  outlet      Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, isActive, sortOrder])
}

model Product {
  id                String                   @id @default(uuid()) @db.Uuid
  outletId          String                   @db.Uuid
  categoryId        String                   @db.Uuid
  name              String                   @db.VarChar(100)
  sku               String                   @db.VarChar(50)
  pricingType       PricingType
  price             Int
  unitCost          Int?
  stock             Int?
  lowStockThreshold Int?
  trackStock        Boolean                  @default(false)
  imageUrl          String?                  @db.VarChar(500)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  category          Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  outlet            Outlet                   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  transactionItems  TransactionItem[]
  inventoryConfig   ProductInventoryConfig?
  inventoryRecipes  InventoryRecipeVersion[]

  @@unique([outletId, sku])
  @@index([outletId, categoryId, isActive])
}

model Transaction {
  id                    String            @id @default(uuid()) @db.Uuid
  outletId              String            @db.Uuid
  clientTransactionId   String            @db.Uuid
  invoiceNo             String            @db.VarChar(32)
  cashierId             String            @db.Uuid
  subtotal              Int
  discount              Int               @default(0)
  tax                   Int               @default(0)
  taxPercentage         Decimal           @default(0) @db.Decimal(5, 2)
  total                 Int
  platformFeeType       FeeType           @default(NONE)
  platformFeeFixed      Int               @default(0)
  platformFeePercentage Decimal           @default(0) @db.Decimal(7, 4)
  platformFeeAmount     Int               @default(0)
  customerName          String            @default("Pelanggan") @db.VarChar(100)
  orderType             OrderType         @default(DINE_IN)
  spicyLevel            Int
  brothLevel            BrothLevel        @default(MEDIUM)
  tastePreference       TastePreference   @default(SAVORY)
  notes                 String?           @db.VarChar(500)
  paymentMethod         PaymentMethod
  amountReceived        Int?
  changeAmount          Int               @default(0)
  status                TransactionStatus @default(PAID)
  kitchenStatus         KitchenStatus     @default(PENDING)
  kitchenCompletedAt    DateTime?         @db.Timestamptz(3)
  paidAt                DateTime          @default(now()) @db.Timestamptz(3)
  voidedAt              DateTime?         @db.Timestamptz(3)
  voidedById            String?           @db.Uuid
  voidReason            String?           @db.VarChar(500)
  storeName             String            @db.VarChar(100)
  storeAddress          String?           @db.VarChar(500)
  storePhone            String?           @db.VarChar(50)
  currency              String            @default("IDR") @db.VarChar(10)
  receiptHeader         String?           @db.VarChar(500)
  receiptFooter         String?           @db.VarChar(500)
  receiptPaperSize      ReceiptPaperSize
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  cashier               User              @relation("CashierTransactions", fields: [cashierId], references: [id], onDelete: Restrict)
  voidedBy              User?             @relation("VoidedTransactions", fields: [voidedById], references: [id], onDelete: Restrict)
  items                 TransactionItem[]
  outlet                Outlet            @relation(fields: [outletId], references: [id], onDelete: Restrict)
  feeLedgers            FeeLedger[]

  @@unique([outletId, invoiceNo])
  @@unique([outletId, clientTransactionId])
  @@index([outletId, paidAt, status])
  @@index([outletId, cashierId, paidAt])
  @@index([outletId, paymentMethod, paidAt])
  @@index([outletId, kitchenStatus, createdAt])
}

model TransactionItem {
  id              String          @id @default(uuid()) @db.Uuid
  outletId        String          @db.Uuid
  transactionId   String          @db.Uuid
  productId       String?         @db.Uuid
  productName     String          @db.VarChar(100)
  categoryId      String?         @db.Uuid
  categoryName    String          @db.VarChar(100)
  sku             String          @db.VarChar(50)
  pricingType     PricingType
  trackStock      Boolean
  unitPrice       Int
  unitCost        Int?
  quantity        Int
  subtotal        Int
  costSubtotal    Int?
  spicyLevel      Int             @default(0)
  brothLevel      BrothLevel      @default(MEDIUM)
  tastePreference TastePreference @default(SAVORY)
  notes           String?         @db.VarChar(500)
  selectedOptions Json?
  kitchenStatus   KitchenStatus   @default(PENDING)
  completedAt     DateTime?       @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  transaction     Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  outlet          Outlet          @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@index([outletId, transactionId])
  @@index([productId])
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  outletId    String   @db.Uuid
  createdById String   @db.Uuid
  description String   @db.VarChar(500)
  amount      Int
  expenseDate DateTime @db.Date
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, expenseDate])
}

model StoreSettings {
  id               String           @id @default("default")
  outletId         String           @unique @db.Uuid
  storeName        String           @default("Saung Sunja") @db.VarChar(100)
  logoUrl          String?          @db.VarChar(500)
  faviconUrl       String?          @db.VarChar(500)
  primaryColor     String           @default("#C2410C") @db.VarChar(7)
  address          String?          @db.VarChar(500)
  phone            String?          @db.VarChar(50)
  currency         String           @default("IDR") @db.VarChar(10)
  taxEnabled       Boolean          @default(false)
  taxPercentage    Decimal          @default(0) @db.Decimal(5, 2)
  receiptHeader    String?          @db.VarChar(500)
  receiptFooter    String?          @db.VarChar(500)
  receiptPaperSize ReceiptPaperSize @default(MM58)
  menuOptions      Json             @default("[]")
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  outlet           Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
}

model DailyInvoiceCounter {
  outletId     String   @db.Uuid
  businessDate DateTime @db.Date
  lastSequence Int
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  outlet       Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@id([outletId, businessDate])
}

model InventoryUnit {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  code                  String                @db.VarChar(30)
  name                  String                @db.VarChar(100)
  symbol                String                @db.VarChar(20)
  dimension             UnitDimension
  isBase                Boolean               @default(false)
  factorToDimensionBase Decimal               @default(1) @db.Decimal(20, 9)
  precision             Int                   @default(3)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseItems             InventoryItem[]
  conversions           ItemUnitConversion[]
  purchaseReceiptLines  PurchaseReceiptLine[]
  stockAdjustmentLines  StockAdjustmentLine[]
  stocktakeLines        StocktakeLine[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, dimension, isActive])
}

model InventoryItem {
  id                   String                   @id @default(uuid()) @db.Uuid
  tenantId             String                   @db.Uuid
  sku                  String                   @db.VarChar(50)
  name                 String                   @db.VarChar(150)
  type                 InventoryItemType
  baseUnitId           String                   @db.Uuid
  reorderPoint         Decimal                  @default(0) @db.Decimal(20, 6)
  allowNegative        Boolean                  @default(false)
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseUnit             InventoryUnit            @relation(fields: [baseUnitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  conversions          ItemUnitConversion[]
  balances             StockBalance[]
  movements            StockMovement[]
  directProductConfigs ProductInventoryConfig[]
  recipeLines          InventoryRecipeLine[]
  purchaseReceiptLines PurchaseReceiptLine[]
  stockAdjustmentLines StockAdjustmentLine[]
  stocktakeLines       StocktakeLine[]
  optionConsumptions   MenuOptionConsumption[]
  prepRecipesProduced  PrepRecipe[]             @relation("PrepRecipeOutput")
  prepRecipeLines      PrepRecipeLine[]
  prepBatchesProduced  PrepBatch[]              @relation("PrepBatchOutput")
  prepBatchInputs      PrepBatchInput[]

  @@unique([tenantId, sku])
  @@unique([id, tenantId])
  @@index([tenantId, type, isActive])
  @@index([tenantId, name])
}

model ItemUnitConversion {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  itemId       String             @db.Uuid
  unitId       String             @db.Uuid
  mode         UnitConversionMode @default(SAME_DIMENSION)
  factorToBase Decimal            @db.Decimal(20, 9)
  density      Decimal?           @db.Decimal(20, 9)
  notes        String?            @db.VarChar(500)
  validFrom    DateTime           @default(now()) @db.Timestamptz(3)
  validTo      DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  item         InventoryItem      @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  unit         InventoryUnit      @relation(fields: [unitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([itemId, unitId, validFrom])
  @@index([tenantId, itemId, validTo])
}

model ProductInventoryConfig {
  id                    String                  @id @default(uuid()) @db.Uuid
  tenantId              String                  @db.Uuid
  productId             String                  @unique @db.Uuid
  locationId            String                  @db.Uuid
  mode                  ProductInventoryMode
  directItemId          String?                 @db.Uuid
  directQuantity        Decimal?                @db.Decimal(20, 6)
  activeRecipeVersionId String?                 @unique @db.Uuid
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product               Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  location              StockLocation           @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  directItem            InventoryItem?          @relation(fields: [directItemId, tenantId], references: [id, tenantId], onDelete: Restrict)
  activeRecipeVersion   InventoryRecipeVersion? @relation("ActiveRecipe", fields: [activeRecipeVersionId], references: [id], onDelete: Restrict)

  @@index([tenantId, locationId])
  @@index([tenantId, mode])
}

model InventoryRecipeVersion {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.Uuid
  productId       String                  @db.Uuid
  version         Int
  notes           String?                 @db.VarChar(500)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines           InventoryRecipeLine[]
  activeForConfig ProductInventoryConfig? @relation("ActiveRecipe")

  @@unique([productId, version])
  @@unique([id, tenantId])
  @@index([tenantId, productId, createdAt])
}

model InventoryRecipeLine {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @db.Uuid
  recipeVersionId String                 @db.Uuid
  itemId          String                 @db.Uuid
  quantity        Decimal                @db.Decimal(20, 6)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeVersion   InventoryRecipeVersion @relation(fields: [recipeVersionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  item            InventoryItem          @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([recipeVersionId, itemId])
  @@index([tenantId, itemId])
}

model StockLocation {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId           String                     @db.Uuid
  outletId           String?                    @db.Uuid
  code               String                     @db.VarChar(50)
  name               String                     @db.VarChar(100)
  type               StockLocationType
  isActive           Boolean                    @default(true)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet             Outlet?                    @relation(fields: [outletId, tenantId], references: [id, tenantId], onDelete: Restrict)
  balances           StockBalance[]
  movements          StockMovement[]
  grants             InventoryPermissionGrant[]
  productConfigs     ProductInventoryConfig[]
  purchaseReceipts   PurchaseReceipt[]
  stockAdjustments   StockAdjustment[]
  stocktakes         Stocktake[]
  optionConsumptions MenuOptionConsumption[]
  prepBatches        PrepBatch[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, type, isActive])
  @@index([outletId, isActive])
}

model StockBalance {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  locationId       String        @db.Uuid
  itemId           String        @db.Uuid
  quantity         Decimal       @default(0) @db.Decimal(20, 6)
  reservedQuantity Decimal       @default(0) @db.Decimal(20, 6)
  averageUnitCost  Decimal?      @db.Decimal(20, 8)
  version          Int           @default(0)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location         StockLocation @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  item             InventoryItem @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, locationId, itemId])
  @@index([tenantId, locationId, quantity])
  @@index([tenantId, itemId])
}

model StockMovement {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @db.Uuid
  locationId     String                 @db.Uuid
  itemId         String                 @db.Uuid
  type           StockMovementType
  direction      StockMovementDirection
  quantity       Decimal                @db.Decimal(20, 6)
  unitCost       Decimal?               @db.Decimal(20, 8)
  amount         Decimal?               @db.Decimal(20, 6)
  balanceAfter   Decimal                @db.Decimal(20, 6)
  sourceType     String                 @db.VarChar(50)
  sourceId       String?                @db.VarChar(100)
  idempotencyKey String                 @db.VarChar(150)
  notes          String?                @db.VarChar(500)
  actorId        String?                @db.Uuid
  occurredAt     DateTime               @default(now()) @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location       StockLocation          @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  item           InventoryItem          @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor          User?                  @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, locationId, itemId, occurredAt, id], map: "StockMovement_tenant_location_item_time_idx")
  @@index([tenantId, sourceType, sourceId])
  @@index([actorId, occurredAt])
}

model InventoryPermissionGrant {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @db.Uuid
  userId     String              @db.Uuid
  locationId String?             @db.Uuid
  scopeKey   String              @default("TENANT") @db.VarChar(50)
  permission InventoryPermission
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   StockLocation?      @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, userId, permission, scopeKey], map: "InventoryPermissionGrant_tenant_user_permission_scope_key")
  @@index([tenantId, permission])
  @@index([userId, locationId])
}

model InventoryAuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   String   @db.VarChar(100)
  payload    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor      User?    @relation("InventoryAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId, createdAt], map: "InventoryAuditEvent_tenant_entity_time_idx")
  @@index([tenantId, actorId, createdAt], map: "InventoryAuditEvent_tenant_actor_time_idx")
}

model PurchaseReceipt {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  locationId      String                @db.Uuid
  clientRequestId String                @db.Uuid
  supplierName    String                @db.VarChar(150)
  referenceNo     String?               @db.VarChar(100)
  notes           String?               @db.VarChar(500)
  totalAmount     Decimal               @db.Decimal(20, 6)
  receivedAt      DateTime              @default(now()) @db.Timestamptz(3)
  createdById     String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location        StockLocation         @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy       User?                 @relation("PurchaseReceiptCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines           PurchaseReceiptLine[]

  @@unique([tenantId, clientRequestId])
  @@unique([id, tenantId])
  @@index([tenantId, receivedAt])
  @@index([tenantId, locationId, receivedAt])
}

model PurchaseReceiptLine {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  receiptId      String          @db.Uuid
  itemId         String          @db.Uuid
  unitId         String          @db.Uuid
  inputQuantity  Decimal         @db.Decimal(20, 6)
  inputUnitPrice Decimal         @db.Decimal(20, 8)
  factorToBase   Decimal         @db.Decimal(20, 9)
  quantity       Decimal         @db.Decimal(20, 6)
  unitCost       Decimal         @db.Decimal(20, 8)
  amount         Decimal         @db.Decimal(20, 6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt        PurchaseReceipt @relation(fields: [receiptId, tenantId], references: [id, tenantId], onDelete: Cascade)
  item           InventoryItem   @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict)
  unit           InventoryUnit   @relation(fields: [unitId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([receiptId, itemId])
  @@index([tenantId, itemId])
}

/// Waste or manual adjustment document. Posted immediately; each line posts one ledger movement.
model StockAdjustment {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  locationId      String                @db.Uuid
  clientRequestId String                @db.Uuid
  kind            StockAdjustmentKind
  reason          StockAdjustmentReason
  notes           String?               @db.VarChar(500)
  totalAmount     Decimal?              @db.Decimal(20, 6)
  occurredAt      DateTime              @default(now()) @db.Timestamptz(3)
  createdById     String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location        StockLocation         @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy       User?                 @relation("StockAdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines           StockAdjustmentLine[]

  @@unique([tenantId, clientRequestId])
  @@unique([id, tenantId])
  @@index([tenantId, kind, occurredAt])
  @@index([tenantId, locationId, occurredAt])
}

model StockAdjustmentLine {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @db.Uuid
  adjustmentId  String                 @db.Uuid
  itemId        String                 @db.Uuid
  unitId        String                 @db.Uuid
  direction     StockMovementDirection
  inputQuantity Decimal                @db.Decimal(20, 6)
  factorToBase  Decimal                @db.Decimal(20, 9)
  quantity      Decimal                @db.Decimal(20, 6)
  unitCost      Decimal?               @db.Decimal(20, 8)
  amount        Decimal?               @db.Decimal(20, 6)
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  adjustment    StockAdjustment        @relation(fields: [adjustmentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  item          InventoryItem          @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict)
  unit          InventoryUnit          @relation(fields: [unitId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([adjustmentId, itemId])
  @@index([tenantId, itemId])
}

/// Stock count session for one location: COUNTING -> REVIEW -> POSTED, or CANCELLED before posting.
/// A migration-only partial unique index allows one open (COUNTING/REVIEW) session per location.
model Stocktake {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  locationId      String          @db.Uuid
  clientRequestId String          @db.Uuid
  status          StocktakeStatus @default(COUNTING)
  notes           String?         @db.VarChar(500)
  createdById     String?         @db.Uuid
  submittedById   String?         @db.Uuid
  submittedAt     DateTime?       @db.Timestamptz(3)
  approvedById    String?         @db.Uuid
  postedAt        DateTime?       @db.Timestamptz(3)
  cancelledById   String?         @db.Uuid
  cancelledAt     DateTime?       @db.Timestamptz(3)
  cancelReason    String?         @db.VarChar(500)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location        StockLocation   @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy       User?           @relation("StocktakeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submittedBy     User?           @relation("StocktakeSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy      User?           @relation("StocktakeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  cancelledBy     User?           @relation("StocktakeCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  lines           StocktakeLine[]

  @@unique([tenantId, clientRequestId])
  @@unique([id, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, locationId, createdAt])
}

/// One counted item. expectedQuantity is the ledger balance when the count was recorded, so sales posted
/// while counting continues are kept: posting applies counted - expected on top of the live balance.
model StocktakeLine {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  stocktakeId      String        @db.Uuid
  itemId           String        @db.Uuid
  unitId           String        @db.Uuid
  inputQuantity    Decimal       @db.Decimal(20, 6)
  factorToBase     Decimal       @db.Decimal(20, 9)
  countedQuantity  Decimal       @db.Decimal(20, 6)
  expectedQuantity Decimal       @db.Decimal(20, 6)
  varianceQuantity Decimal       @db.Decimal(20, 6)
  unitCost         Decimal?      @db.Decimal(20, 8)
  varianceAmount   Decimal?      @db.Decimal(20, 6)
  notes            String?       @db.VarChar(500)
  countedById      String?       @db.Uuid
  countedAt        DateTime      @default(now()) @db.Timestamptz(3)
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stocktake        Stocktake     @relation(fields: [stocktakeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  item             InventoryItem @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict)
  unit             InventoryUnit @relation(fields: [unitId, tenantId], references: [id, tenantId], onDelete: Restrict)
  countedBy        User?         @relation("StocktakeCounter", fields: [countedById], references: [id], onDelete: SetNull)

  @@unique([stocktakeId, itemId])
  @@index([tenantId, itemId])
}

/// Ingredients one menu option value (from StoreSettings.menuOptions) consumes per product sold with it,
/// e.g. "Level 3" = 15 g chili. Group/value ids are the outlet's option ids; changing a mapping never
/// rewrites consumption already posted.
model MenuOptionConsumption {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  outletId   String        @db.Uuid
  groupId    String        @db.VarChar(50)
  valueId    String        @db.VarChar(50)
  locationId String        @db.Uuid
  itemId     String        @db.Uuid
  quantity   Decimal       @db.Decimal(20, 6)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(3)
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet     Outlet        @relation(fields: [outletId, tenantId], references: [id, tenantId], onDelete: Cascade)
  location   StockLocation @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  item       InventoryItem @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([outletId, groupId, valueId, itemId])
  @@index([tenantId, itemId])
}

enum PrepBatchStatus {
  IN_PROGRESS
  COMPLETED
  VOIDED
}

/// Standard formula for one semi-finished item, e.g. 1000 g chili + 100 ml oil -> 900 g sambal. Batches copy
/// the quantities they actually used, so editing a recipe never changes past batches.
model PrepRecipe {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  outputItemId   String           @db.Uuid
  outputQuantity Decimal          @db.Decimal(20, 6)
  notes          String?          @db.VarChar(500)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outputItem     InventoryItem    @relation("PrepRecipeOutput", fields: [outputItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  lines          PrepRecipeLine[]

  @@unique([tenantId, outputItemId])
  @@unique([id, tenantId])
}

model PrepRecipeLine {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  recipeId  String        @db.Uuid
  itemId    String        @db.Uuid
  quantity  Decimal       @db.Decimal(20, 6)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipe    PrepRecipe    @relation(fields: [recipeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([recipeId, itemId])
  @@index([tenantId, itemId])
}

/// One production run at a location: inputs are issued when it starts (IN_PROGRESS); completing it receives
/// the actual output carrying the whole input cost. Voiding an in-progress batch returns or wastes the inputs.
model PrepBatch {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  locationId      String           @db.Uuid
  clientRequestId String           @db.Uuid
  outputItemId    String           @db.Uuid
  status          PrepBatchStatus  @default(IN_PROGRESS)
  plannedQuantity Decimal          @db.Decimal(20, 6)
  actualQuantity  Decimal?         @db.Decimal(20, 6)
  inputCost       Decimal?         @db.Decimal(20, 6)
  outputUnitCost  Decimal?         @db.Decimal(20, 8)
  notes           String?          @db.VarChar(500)
  startedAt       DateTime         @default(now()) @db.Timestamptz(3)
  startedById     String?          @db.Uuid
  completedAt     DateTime?        @db.Timestamptz(3)
  completedById   String?          @db.Uuid
  voidedAt        DateTime?        @db.Timestamptz(3)
  voidedById      String?          @db.Uuid
  voidReason      String?          @db.VarChar(500)
  voidDisposition String?          @db.VarChar(20)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location        StockLocation    @relation(fields: [locationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  outputItem      InventoryItem    @relation("PrepBatchOutput", fields: [outputItemId, tenantId], references: [id, tenantId], onDelete: Restrict)
  startedBy       User?            @relation("PrepBatchStarter", fields: [startedById], references: [id], onDelete: SetNull)
  completedBy     User?            @relation("PrepBatchCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  voidedBy        User?            @relation("PrepBatchVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  inputs          PrepBatchInput[]

  @@unique([tenantId, clientRequestId])
  @@unique([id, tenantId])
  @@index([tenantId, status, startedAt])
  @@index([tenantId, locationId, startedAt])
}

model PrepBatchInput {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  batchId   String        @db.Uuid
  itemId    String        @db.Uuid
  quantity  Decimal       @db.Decimal(20, 6)
  unitCost  Decimal?      @db.Decimal(20, 8)
  amount    Decimal?      @db.Decimal(20, 6)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch     PrepBatch     @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([batchId, itemId])
  @@index([tenantId, itemId])
}
